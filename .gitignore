# Python, uv and the lint/test caches
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.env
.envrc

# Editor settings, including the schema `strata dev schema` writes
.vscode/

# Local agent instructions
CLAUDE.md

# Private notes
docs/**/.*

# Ansible run output and the vault-encrypted secrets
*.retry
ansible/artifacts/
ansible/env/
ansible/inventory/group_vars/secrets/

# The real inventory: it names your machines, addresses, accounts, storage
# remotes and ports. Start from the .example file beside each.
ansible/inventory/hosts.ini
ansible/inventory/host_vars/*.yml
ansible/inventory/group_vars/all/managed.yml

# The external projects installed from this machine: paths to your own checkouts.
ansible/projects.yml
