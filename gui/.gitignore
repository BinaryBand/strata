# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---- strata: aggressively ignore everything regenerable ----
# Only gui/lib/, pubspec.yaml, pubspec.lock, analysis_options.yaml, .metadata
# and this README are tracked. Everything below is `flutter create` output or
# build/tool state: recreate it with `flutter create .` in gui/ (see README).

# Generated platform runners. They contain no hand-written code -- only the
# project name, which comes from pubspec.yaml.
/linux/
/macos/
/windows/
/web/
/android/
/ios/

# Tool and build state (also matched above, kept explicit so a nested copy dies too)
**/.dart_tool/
**/build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
